@@ -50,6 +50,13 @@ jobs:
             awk '/\[E\]/{p=1} p{print; n++} n>=40{exit}' flutter_test.txt
             echo '```'
           } >> "$GITHUB_STEP_SUMMARY"
+          # 324i: annotations are readable without a GitHub sign-in, so the
+          # failing test names go there too - a red run names itself.
+          tr -d '\r' < flutter_test.txt | grep -E '\[E\]$' \
+            | sed -E 's/^[0-9:]+ \+[0-9]+ -[0-9]+: //; s/ *\[E\]$//' | head -5 > fails.txt || true
+          while IFS= read -r f; do
+            [ -n "$f" ] && echo "::error title=Failing test::$f"
+          done < fails.txt
           exit $code
