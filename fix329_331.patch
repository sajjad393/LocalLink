diff --git a/lib/features/admin/data/evidence_329.dart b/lib/features/admin/data/evidence_329.dart
new file mode 100644
index 0000000..d9e2221
--- /dev/null
+++ b/lib/features/admin/data/evidence_329.dart
@@ -0,0 +1,195 @@
+import 'dart:convert';
+
+import 'package:crypto/crypto.dart';
+
+/// Bundle 329: export evidence.
+///
+/// A plain record of what THIS phone did - asks it made, answers it gave, and
+/// the owner's answers to the 326 consent cards - written so that any later
+/// edit shows up. Each line carries the hash of the line before it, so if a
+/// single word is changed, [verify] says which line broke.
+///
+/// **No server, no internet, nothing expires.** The file is made on the phone
+/// and leaves it only when the owner copies it out. It is a record, not a
+/// promise: it proves what this phone wrote, nothing more - saying that plainly
+/// is the point.
+class Evidence329 {
+  Evidence329({
+    Future<String?> Function(String key)? read,
+    Future<void> Function(String key, String value)? write,
+    DateTime Function()? clock,
+  })  : _read = read ?? _memoryRead,
+        _write = write ?? _memoryWrite,
+        _clock = clock ?? DateTime.now;
+
+  /// The key the lines are kept under on this phone.
+  static const String key = 'evidence_329';
+
+  /// Never change: it is part of every hash.
+  static const String domain = 'locallink-evidence-329';
+
+  /// How many lines are kept. Old lines drop off the front, newest kept.
+  static const int keep = 500;
+
+  final Future<String?> Function(String key) _read;
+  final Future<void> Function(String key, String value) _write;
+  final DateTime Function() _clock;
+
+  static final Map<String, String> _mem = {};
+  static Future<String?> _memoryRead(String k) async => _mem[k];
+  static Future<void> _memoryWrite(String k, String v) async => _mem[k] = v;
+
+  /// The one used by the app. Tests build their own.
+  static Evidence329 instance = Evidence329();
+
+  /// Point the app's instance at the real phone storage.
+  static void bind({
+    required Future<String?> Function(String key) read,
+    required Future<void> Function(String key, String value) write,
+  }) {
+    instance = Evidence329(read: read, write: write);
+  }
+
+  static void resetForTest() {
+    _mem.clear();
+    instance = Evidence329();
+  }
+
+  /// One line: `{"n":1,"at":"...","kind":"ask","words":"...","prev":"","hash":"..."}`
+  Future<({int n, String at, String kind, String words, String prev, String hash})?>
+      last() async {
+    final lines = _lines(await _read(key) ?? '');
+    if (lines.isEmpty) return null;
+    return _asRecord(lines.last);
+  }
+
+  /// Add one line. Returns the new line count.
+  Future<int> add(String kind, String words) async {
+    final text = await _read(key) ?? '';
+    final lines = _lines(text);
+    final prev = lines.isEmpty ? '' : (_asRecord(lines.last)?.hash ?? '');
+    final n = lines.isEmpty ? 1 : (_asRecord(lines.last)?.n ?? lines.length) + 1;
+    final rec = _record(n: n, at: _iso(_clock()), kind: kind, words: words, prev: prev);
+    lines.add(lineOf(rec));
+    final kept = lines.length > keep ? lines.sublist(lines.length - keep) : lines;
+    await _write(key, kept.join('\n'));
+    return kept.length;
+  }
+
+  /// How many lines this phone holds.
+  Future<int> count() async => _lines(await _read(key) ?? '').length;
+
+  /// The whole file, ready to copy out.
+  Future<String> export() async {
+    final lines = _lines(await _read(key) ?? '');
+    if (lines.isEmpty) return '';
+    return [
+      '# LocalLink evidence · $domain',
+      '# lines: ${lines.length}',
+      '# each line carries the hash of the line before it',
+      ...lines,
+    ].join('\n');
+  }
+
+  /// Check a file (the export, or one the user pasted). Stops at the first line
+  /// that does not add up and says which one - never "looks fine" when it does
+  /// not.
+  static ({bool ok, int lines, int firstBad, String why}) verify(String text) {
+    final rows = _lines(text);
+    if (rows.isEmpty) {
+      return (ok: false, lines: 0, firstBad: 0, why: 'empty');
+    }
+    var prev = '';
+    for (var i = 0; i < rows.length; i++) {
+      final rec = _asRecord(rows[i]);
+      if (rec == null) return (ok: false, lines: i, firstBad: i + 1, why: 'not a line');
+      if (rec.n != i + 1) return (ok: false, lines: i, firstBad: i + 1, why: 'number');
+      if (rec.prev != prev) return (ok: false, lines: i, firstBad: i + 1, why: 'chain');
+      if (rec.hash != _hashOf(rec)) return (ok: false, lines: i, firstBad: i + 1, why: 'changed');
+      prev = rec.hash;
+    }
+    return (ok: true, lines: rows.length, firstBad: 0, why: '');
+  }
+
+  /// Big words for the two things the owner can do with it.
+  static String fileWords(int lines) =>
+      lines == 0 ? 'Nothing recorded yet' : '$lines line${lines == 1 ? '' : 's'} on this phone';
+
+  // ---------------------------------------------------------------- inside
+
+  static List<String> _lines(String text) => text
+      .split('\n')
+      .map((l) => l.trim())
+      .where((l) => l.isNotEmpty && !l.startsWith('#'))
+      .toList();
+
+  static String _iso(DateTime t) => t.toUtc().toIso8601String();
+
+  static ({int n, String at, String kind, String words, String prev, String hash}) _record({
+    required int n,
+    required String at,
+    required String kind,
+    required String words,
+    required String prev,
+  }) {
+    final body = <String, String>{
+      'n': '$n',
+      'at': at,
+      'kind': _clean(kind),
+      'words': _clean(words),
+      'prev': prev,
+    };
+    final hash = _hashBody(body);
+    return (
+      n: n,
+      at: at,
+      kind: body['kind']!,
+      words: body['words']!,
+      prev: prev,
+      hash: hash,
+    );
+  }
+
+  static String _hashBody(Map<String, String> body) => sha256
+      .convert(utf8.encode(
+          '$domain|${body['n']}|${body['at']}|${body['kind']}|${body['words']}|${body['prev']}'))
+      .toString();
+
+  static String _hashOf(({int n, String at, String kind, String words, String prev, String hash}) rec) =>
+      _hashBody({
+        'n': '${rec.n}',
+        'at': rec.at,
+        'kind': rec.kind,
+        'words': rec.words,
+        'prev': rec.prev,
+      });
+
+  /// One line of text per line of the file: newlines inside a word would break
+  /// the file, so they become spaces.
+  static String _clean(String s) => s.replaceAll('\n', ' ').replaceAll('\r', ' ').trim();
+
+  static ({int n, String at, String kind, String words, String prev, String hash})? _asRecord(
+      String line) {
+    if (!line.startsWith('{')) return null;
+    try {
+      final m = jsonDecode(line);
+      if (m is! Map) return null;
+      final n = m['n'];
+      if (n is! num) return null;
+      return (
+        n: n.toInt(),
+        at: m['at']?.toString() ?? '',
+        kind: m['kind']?.toString() ?? '',
+        words: m['words']?.toString() ?? '',
+        prev: m['prev']?.toString() ?? '',
+        hash: m['hash']?.toString() ?? '',
+      );
+    } catch (_) {
+      return null;
+    }
+  }
+
+  /// The line as it is written to the file.
+  static String lineOf(({int n, String at, String kind, String words, String prev, String hash}) r) =>
+      jsonEncode({'n': r.n, 'at': r.at, 'kind': r.kind, 'words': r.words, 'prev': r.prev, 'hash': r.hash});
+}
diff --git a/lib/features/admin/data/honest_331.dart b/lib/features/admin/data/honest_331.dart
new file mode 100644
index 0000000..e77a4d0
--- /dev/null
+++ b/lib/features/admin/data/honest_331.dart
@@ -0,0 +1,126 @@
+import 'package:locallink/features/admin/data/evidence_329.dart';
+
+/// Bundle 331: honest dates, and what this phone can really do right now.
+///
+/// Two small things, both about not pretending:
+/// * **dates** - "just now", "12 minutes ago", "today · 18:40", "yesterday",
+///   "3 days ago", then the day itself. No fake precision ("0 days ago"), no
+///   time invented for a phone that never synced.
+/// * **the digest** - where an ask can actually go at this moment: phone to
+///   phone, over the server, or nowhere yet. It says "nowhere yet" instead of
+///   showing a spinner that implies something is on its way.
+class Honest331 {
+  /// A date in words a person would use. [now] and [then] are local times.
+  static ({String words, bool exact}) ago(DateTime now, DateTime then) {
+    final d = now.difference(then);
+    if (d.isNegative) {
+      // a clock that is behind: say so instead of "in -3 minutes"
+      return (words: 'time is off', exact: false);
+    }
+    if (d.inSeconds < 45) return (words: 'just now', exact: false);
+    if (d.inMinutes < 60) {
+      final m = d.inMinutes;
+      return (words: '$m minute${m == 1 ? '' : 's'} ago', exact: false);
+    }
+    final today = DateTime(now.year, now.month, now.day);
+    final that = DateTime(then.year, then.month, then.day);
+    final days = today.difference(that).inDays;
+    final hhmm = _hhmm(then);
+    if (days == 0) return (words: 'today · $hhmm', exact: true);
+    if (days == 1) return (words: 'yesterday · $hhmm', exact: true);
+    if (days < 7) return (words: '$days days ago', exact: false);
+    final sameYear = now.year == then.year;
+    return (words: '${_day(then.month)} ${then.day}${sameYear ? '' : ' ${then.year}'}', exact: true);
+  }
+
+  static String _hhmm(DateTime t) =>
+      '${t.hour.toString().padLeft(2, '0')}:${t.minute.toString().padLeft(2, '0')}';
+
+  static String _day(int month) => const [
+        'Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', //
+        'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec',
+      ][(month - 1).clamp(0, 11)];
+}
+
+/// What an ask can do right now, said plainly.
+class CanDo331 {
+  /// How many of my phones are linked at this moment.
+  static String peersWords(int n) {
+    if (n <= 0) return 'no phones nearby';
+    if (n == 1) return '1 phone nearby';
+    return '$n phones nearby';
+  }
+
+  /// Where an ask would go: `lan` (phone to phone), `server`, or `waiting`.
+  static String route({required int nearby, required bool server}) {
+    if (nearby > 0) return 'lan';
+    if (server) return 'server';
+    return 'waiting';
+  }
+
+  /// The sentence for the route, and whether it is good news.
+  static ({String words, bool good}) routeWords({required int nearby, required bool server}) {
+    switch (route(nearby: nearby, server: server)) {
+      case 'lan':
+        return (words: 'phone to phone · 0 MB', good: true);
+      case 'server':
+        return (words: 'over the server · needs internet', good: true);
+      default:
+        return (words: 'waiting - nothing can travel yet', good: false);
+    }
+  }
+
+  /// The honest line about what a phone-to-phone ask costs.
+  static String costWords({required int nearby}) =>
+      nearby > 0 ? 'nothing goes to the server' : 'nothing is sent until a phone is near';
+}
+
+/// The three facts the digest screen needs, gathered in one place so it can be
+/// tested without a phone.
+class CanDoFacts331 {
+  const CanDoFacts331({
+    required this.nearby,
+    required this.server,
+    this.lastRecord = '',
+    this.lastAt,
+  });
+
+  final int nearby;
+  final bool server;
+  final String lastRecord;
+  final DateTime? lastAt;
+
+  /// The facts, as the app can know them right now. Only things this phone can
+  /// truly see - no guessing about the internet.
+  static Future<CanDoFacts331> read({
+    Future<List<String>> Function()? linkedPeers,
+    bool Function()? serverOnline,
+    Future<({int n, String at, String kind, String words, String prev, String hash})?> Function()? last,
+    DateTime Function()? clock,
+  }) async {
+    var peers = 0;
+    try {
+      peers = (await linkedPeers?.call())?.where((p) => p.isNotEmpty).length ?? 0;
+    } catch (_) {
+      peers = 0;
+    }
+    var server = false;
+    try {
+      server = serverOnline?.call() ?? false;
+    } catch (_) {
+      server = false;
+    }
+    var words = '';
+    DateTime? at;
+    try {
+      final l = await (last ?? Evidence329.instance.last)();
+      if (l != null) {
+        words = l.words;
+        at = DateTime.tryParse(l.at)?.toLocal();
+      }
+    } catch (_) {
+      words = '';
+    }
+    return CanDoFacts331(nearby: peers, server: server, lastRecord: words, lastAt: at);
+  }
+}
