<!-- Brand launch background: hero gradient (topLeft -> bottomRight) with the
     centered LocalLink splash logo. Shown for the first frames before Flutter
     renders, and after the Android 12+ system splash is dismissed. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="@color/brand_start"
                android:endColor="@color/brand_end"
                android:angle="315" />
        </shape>
    </item>
    <item>
        <bitmap
            android:src="@drawable/splash_logo"
            android:gravity="center" />
    </item>
</layer-list>
